-    {
-        if (IsPublishEvent(appsyncEvent))
-        {
-            return await HandlePublishEvent(appsyncEvent, context);
-        }
-
-        if (IsSubscribeEvent(appsyncEvent))
-        {
-            return (await HandleSubscribeEvent(appsyncEvent, context))!;
